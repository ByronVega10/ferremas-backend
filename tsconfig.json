{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2021",

    "moduleResolution": "node",

    "declaration": true,
    "removeComments": true,

    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,

    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,

    "sourceMap": true,

    "outDir": "./dist",
    "rootDir": "./src",

    "baseUrl": "./",

    "incremental": true,

    "skipLibCheck": true,

    "strictNullChecks": false,
    "noImplicitAny": false
  },

  "include": ["src/**/*.ts"],

  "exclude": [
    "node_modules",
    "dist",
    "test",
    "prisma",
    "**/*spec.ts"
  ]
}